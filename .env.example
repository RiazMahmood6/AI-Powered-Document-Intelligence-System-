DATABASE_URL=sqlite:///docintel.db
UPLOAD_DIR=uploads
MAX_FILE_MB=50
MAX_REQUEST_MB=500

# ---- Background jobs ----
WORKER_THREADS=4

# ---- OCR ----
OCR_LANG=eng
OCR_DPI=200
OCR_PSM=6
# Path to tesseract binary if not on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# ---- AI extraction ----
# heuristic = regex only | hybrid = regex first, LLM only when needed | llm = LLM for every invoice
EXTRACTION_MODE=hybrid
# openai | groq | anthropic
LLM_PROVIDER=openai
# Put your key in the matching variable (or use LLM_API_KEY for any provider)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=
# Optional overrides. Defaults: openai=gpt-4o-mini, groq=llama-3.3-70b-versatile
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_CALLS_PER_DOC=150
# true = 03/04/2024 is 3 April, false = March 4
DATE_DAYFIRST=true

# ---- Validation ----
AMOUNT_TOLERANCE=0.02
MIN_FIELD_CONFIDENCE=0.6

# ---- Search ----
# hashing = built-in, no downloads | sbert = sentence-transformers (pip install sentence-transformers)
EMBEDDING_BACKEND=hashing
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
